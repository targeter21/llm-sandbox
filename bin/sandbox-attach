#!/usr/bin/env bash
# sandbox-attach - Open a shell in a running sandbox container.
#
# Usage:
#   sandbox-attach                                   list running sandboxes
#   sandbox-attach <session-branch> [command...]     attach to the sandbox of that session branch
#   sandbox-attach -b <branch> [command...]          attach to a sandbox started from <branch>
#
# <session-branch> is the temporary branch the sandbox created, e.g.
# claude-session/main/12345_1700000000 (shown at launch and by the listing).
# With -b, <branch> is the branch you launched the sandbox from (for example the
# PR or issue branch). If exactly one running sandbox matches it is joined;
# if several match you pick one with fzf (or a numbered menu if fzf is missing).
# The command defaults to bash and runs in /workspace.
set -euo pipefail

SESSION_LABEL="llm-sandbox.branch"
BASE_LABEL="llm-sandbox.base-branch"
FORMAT="{{.Names}}\t{{.Label \"$SESSION_LABEL\"}}\t{{.Label \"$BASE_LABEL\"}}\t{{.Status}}"

# list_containers [label-filter] - tab separated: name, session branch, base branch, status
list_containers() {
    podman ps --filter "label=${1:-$SESSION_LABEL}" --format "$FORMAT"
}

BASE_BRANCH=""
if [ "${1:-}" = "-b" ]; then
    if [ -z "${2:-}" ]; then
        echo "ERROR: -b requires a branch name." >&2
        exit 1
    fi
    BASE_BRANCH="$2"
    shift 2
fi

if [ -z "$BASE_BRANCH" ] && [ "$#" -eq 0 ]; then
    { printf 'CONTAINER\tSESSION BRANCH\tBASE BRANCH\tSTATUS\n'; list_containers; } | column -t -s $'\t'
    exit 0
fi

if [ -n "$BASE_BRANCH" ]; then
    matches="$(list_containers "$BASE_LABEL=$BASE_BRANCH")"
    what="started from branch '$BASE_BRANCH'"
else
    SESSION_BRANCH="$1"
    shift
    matches="$(list_containers "$SESSION_LABEL=$SESSION_BRANCH")"
    what="for session branch '$SESSION_BRANCH'"
fi

CMD=("$@")
[ "${#CMD[@]}" -gt 0 ] || CMD=(bash)

if [ -z "$matches" ]; then
    echo "ERROR: no running sandbox container found $what." >&2
    echo "Running sandboxes:" >&2
    { printf 'CONTAINER\tSESSION BRANCH\tBASE BRANCH\tSTATUS\n'; list_containers; } | column -t -s $'\t' >&2
    exit 1
fi

count="$(printf '%s\n' "$matches" | wc -l)"
if [ "$count" -eq 1 ]; then
    container="${matches%%$'\t'*}"
elif command -v fzf >/dev/null 2>&1; then
    choice="$(printf '%s\n' "$matches" | fzf --delimiter=$'\t' --with-nth=1.. \
        --prompt="sandbox ($what)> " --header="CONTAINER  SESSION BRANCH  BASE BRANCH  STATUS")" || exit 1
    container="${choice%%$'\t'*}"
else
    echo "Multiple sandboxes $what (install fzf for a nicer picker):"
    mapfile -t lines <<<"$matches"
    PS3="Select a sandbox: "
    select line in "${lines[@]}"; do
        [ -n "$line" ] && { container="${line%%$'\t'*}"; break; }
    done
    : "${container:?no sandbox selected}"
fi

exec podman exec -it -w /workspace "$container" "${CMD[@]}"
